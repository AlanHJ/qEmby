#!/bin/sh
set -eu

HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export APPDIR="$HERE"
# Private ELF RPATHs resolve application libraries. Do not export them to host
# helpers: newer coreutils/systemd may require symbols absent in bundled libs.
# Keep host desktop Qt plugins from mixing with the bundled Qt version.
export QT_PLUGIN_PATH="$HERE/usr/lib/qemby/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$QT_PLUGIN_PATH/platforms"
unset QT_QPA_PLATFORMTHEME
if [ -z "${XKB_CONFIG_ROOT:-}" ] || [ ! -d "$XKB_CONFIG_ROOT" ]; then
    export XKB_CONFIG_ROOT="$HERE/usr/share/X11/xkb"
fi
export XDG_DATA_DIRS="$HERE/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}:/usr/local/share:/usr/share"
if [ -n "${QEMBY_QPA_PLATFORM:-}" ]; then
    export QT_QPA_PLATFORM="$QEMBY_QPA_PLATFORM"
elif [ -z "${QT_QPA_PLATFORM:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM='wayland;xcb'
fi

# Bypass the DEB wrapper: it invokes host readlink/dirname after environment
# setup, and is unnecessary inside the already located AppDir.
exec "$HERE/usr/lib/qemby/qEmbyApp" "$@"
