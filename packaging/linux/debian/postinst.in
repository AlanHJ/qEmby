#!/bin/sh
set -e

remove_qemby_legacy_path() {
    path="$1"

    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        return 0
    fi

    owner="$(dpkg-query -S "$path" 2>/dev/null | sed 's/:.*//' | head -n 1 || true)"
    case "$owner" in
        ""|qemby)
            rm -f -- "$path"
            ;;
    esac
}

remove_qemby_legacy_qt_conf() {
    path="/usr/bin/qt.conf"

    if [ ! -f "$path" ]; then
        return 0
    fi

    if grep -Eq '^(Libraries|Plugins|QmlImports|Translations) = (lib/qemby|plugins|qml|translations)' "$path"; then
        remove_qemby_legacy_path "$path"
    fi
}

remove_qemby_legacy_plugins() {
    for path in \
        /usr/plugins/egldeviceintegrations/libqeglfs-emu-integration.so \
        /usr/plugins/egldeviceintegrations/libqeglfs-kms-egldevice-integration.so \
        /usr/plugins/egldeviceintegrations/libqeglfs-kms-integration.so \
        /usr/plugins/egldeviceintegrations/libqeglfs-x11-integration.so \
        /usr/plugins/iconengines/libqsvgicon.so \
        /usr/plugins/imageformats/libqgif.so \
        /usr/plugins/imageformats/libqicns.so \
        /usr/plugins/imageformats/libqico.so \
        /usr/plugins/imageformats/libqjpeg.so \
        /usr/plugins/imageformats/libqsvg.so \
        /usr/plugins/imageformats/libqtga.so \
        /usr/plugins/imageformats/libqtiff.so \
        /usr/plugins/imageformats/libqwbmp.so \
        /usr/plugins/imageformats/libqwebp.so \
        /usr/plugins/networkinformation/libqglib.so \
        /usr/plugins/networkinformation/libqnetworkmanager.so \
        /usr/plugins/platforminputcontexts/libfcitx5platforminputcontextplugin.so \
        /usr/plugins/platforms/libqxcb.so \
        /usr/plugins/tls/libqopensslbackend.so \
        /usr/plugins/xcbglintegrations/libqxcb-egl-integration.so \
        /usr/plugins/xcbglintegrations/libqxcb-glx-integration.so
    do
        remove_qemby_legacy_path "$path"
    done

    rmdir \
        /usr/plugins/egldeviceintegrations \
        /usr/plugins/iconengines \
        /usr/plugins/imageformats \
        /usr/plugins/networkinformation \
        /usr/plugins/platforminputcontexts \
        /usr/plugins/platforms \
        /usr/plugins/tls \
        /usr/plugins/xcbglintegrations \
        /usr/plugins 2>/dev/null || true
}

remove_qemby_legacy_translations() {
    if [ -d /usr/translations ]; then
        for path in /usr/translations/qt_*.qm; do
            [ -e "$path" ] || continue
            remove_qemby_legacy_path "$path"
        done
        rmdir /usr/translations 2>/dev/null || true
    fi
}

remove_qemby_legacy_libraries() {
    for path in \
        /usr/lib/libQt6Core.so.6 /usr/lib/libQt6Core.so.6.* \
        /usr/lib/libQt6DBus.so.6 /usr/lib/libQt6DBus.so.6.* \
        /usr/lib/libQt6EglFSDeviceIntegration.so.6 /usr/lib/libQt6EglFSDeviceIntegration.so.6.* \
        /usr/lib/libQt6EglFsKmsGbmSupport.so.6 /usr/lib/libQt6EglFsKmsGbmSupport.so.6.* \
        /usr/lib/libQt6EglFsKmsSupport.so.6 /usr/lib/libQt6EglFsKmsSupport.so.6.* \
        /usr/lib/libQt6Gui.so.6 /usr/lib/libQt6Gui.so.6.* \
        /usr/lib/libQt6Network.so.6 /usr/lib/libQt6Network.so.6.* \
        /usr/lib/libQt6OpenGL.so.6 /usr/lib/libQt6OpenGL.so.6.* \
        /usr/lib/libQt6OpenGLWidgets.so.6 /usr/lib/libQt6OpenGLWidgets.so.6.* \
        /usr/lib/libQt6Svg.so.6 /usr/lib/libQt6Svg.so.6.* \
        /usr/lib/libQt6WaylandClient.so /usr/lib/libQt6WaylandClient.so.6 /usr/lib/libQt6WaylandClient.so.6.* \
        /usr/lib/libQt6WebSockets.so.6 /usr/lib/libQt6WebSockets.so.6.* \
        /usr/lib/libQt6Widgets.so.6 /usr/lib/libQt6Widgets.so.6.* \
        /usr/lib/libQt6XcbQpa.so.6 /usr/lib/libQt6XcbQpa.so.6.* \
        /usr/lib/libFcitx5Qt6DBusAddons.so /usr/lib/libFcitx5Qt6DBusAddons.so.1 /usr/lib/libFcitx5Qt6DBusAddons.so.* \
        /usr/lib/libicudata.so.73 /usr/lib/libicudata.so.73.* \
        /usr/lib/libicui18n.so.73 /usr/lib/libicui18n.so.73.* \
        /usr/lib/libicuuc.so.73 /usr/lib/libicuuc.so.73.*
    do
        [ -e "$path" ] || [ -L "$path" ] || continue
        remove_qemby_legacy_path "$path"
    done
}

case "${1:-}" in
    configure)
        remove_qemby_legacy_qt_conf
        remove_qemby_legacy_plugins
        remove_qemby_legacy_translations
        remove_qemby_legacy_libraries
        ;;
esac

exit 0
